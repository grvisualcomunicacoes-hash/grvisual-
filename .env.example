# ============================================================
# GR Visual Comunicações — variáveis de ambiente (EXEMPLO)
# Copie para .env.local (no computador) ou cadastre na Vercel.
# NUNCA coloque valores reais neste arquivo.
# ============================================================

# Endereço público do site (sem barra no final)
NEXT_PUBLIC_SITE_URL=https://seudominio.com.br

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=cole-aqui-a-chave-anon-public

# Chave secreta (service_role). Usada SOMENTE no servidor para gravar pedidos.
# Não começa com NEXT_PUBLIC_ de propósito: assim ela nunca vai para o navegador.
SUPABASE_SERVICE_ROLE_KEY=cole-aqui-a-chave-service-role

# Resend (envio de e-mail dos pedidos) → resend.com → API Keys
RESEND_API_KEY=
# Remetente. Sem domínio próprio verificado, use onboarding@resend.dev
# (nesse modo o Resend só entrega para o e-mail dono da conta Resend).
EMAIL_FROM=GR Visual Site <onboarding@resend.dev>
# Para onde os pedidos são enviados
ORDER_NOTIFY_EMAIL=grvisualcomunicacoes@gmail.com
